# Application
APP_ENV=development
APP_NAME=the-textile-care
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Database
POSTGRES_DB=the_textile_care
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Authentication
AUTH_SECRET=change-me
AUTH_URL=http://localhost:8000
AUTH_PROVIDER=placeholder

# Cloudflare
CLOUDFLARE_API_TOKEN=change-me
CLOUDFLARE_ACCOUNT_ID=change-me
CLOUDFLARE_ZONE_ID=change-me
R2_BUCKET=the-textile-care-assets
R2_PUBLIC_URL=https://example.r2.dev

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=the-textile-care-local

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=

# Payments
PAYMENTS_PROVIDER=placeholder
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Notifications
NOTIFICATIONS_PROVIDER=placeholder
MAILER_PROVIDER=placeholder

# Mobile
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=The Textile Care
